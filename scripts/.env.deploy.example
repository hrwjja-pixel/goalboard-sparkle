# 배포 서버 설정 예시
# 실제 사용 시: cp .env.deploy.example .env.deploy 후 값 수정

DEPLOY_SERVER_USER=ktg2926
DEPLOY_SERVER_HOST=172.16.125.185
DEPLOY_SERVER_PORT=2022
DEPLOY_SERVER_PATH=/home/ktg2926/dashboard

# nginx가 정적 파일을 서빙하는 경로 (선택사항)
# 배포 경로와 nginx 경로가 다른 경우 설정
# 설정하면 배포 후 자동으로 dist 파일 복사 및 nginx 재시작
NGINX_DIST_PATH=/home/apps/dashboard/dist
