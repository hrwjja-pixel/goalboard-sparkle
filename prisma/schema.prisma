generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                String     @id @default(uuid())
  name              String     @unique
  description       String?
  dashboardTitle    String     @default("목표 대시보드")
  dashboardSubtitle String     @default("")
  parentId          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  categories        Category[]
  goals             Goal[]
  parent            Project?   @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          Project[]  @relation("ProjectHierarchy")

  @@index([name])
  @@index([parentId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goals     Goal[]   @relation("CategoryToGoal")

  @@unique([name, projectId])
  @@index([projectId])
}

model Goal {
  id          String       @id @default(uuid())
  title       String
  description String?
  owner       String
  projectId   String
  progress    Int          @default(0)
  size        String       @default("medium")
  startDate   String?
  dueDate     String?
  statusNote  String?
  order       Int          @default(0)
  completed   Boolean      @default(false)
  version     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes       Note[]
  subGoals    SubGoal[]
  categories  Category[]   @relation("CategoryToGoal")

  @@index([owner])
  @@index([projectId])
}

model SubGoal {
  id          String   @id @default(uuid())
  title       String
  description String?
  owner       String
  progress    Int      @default(0)
  startDate   String?
  dueDate     String?
  statusNote  String?
  goalId      String
  order       Int      @default(0)
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Note {
  id        String   @id @default(uuid())
  content   String
  isPinned  Boolean  @default(false)
  goalId    String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model User {
  id        String     @id @default(uuid())
  googleId  String     @unique
  email     String     @unique
  name      String
  picture   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]

  @@index([email])
  @@index([googleId])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE, UPDATE, DELETE, REORDER
  entityType  String   // Goal, SubGoal, Note, Attachment, Category, Project
  entityId    String
  entityTitle String?
  goalId      String?  // 연관 목표 ID (목표별 이력 조회용)
  projectId   String?  // 프로젝트 ID (프로젝트별 조회용)
  summary     String?  // 사람이 읽기 쉬운 요약
  ipAddress   String?  // 사용자 IP 주소 (계정관리 없으므로 IP로 식별)
  userId      String?  // nullable (현재 계정관리 없음)
  changes     String?  // JSON 형태의 변경 내용
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([goalId])
  @@index([projectId])
  @@index([ipAddress])
  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Attachment {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  goalId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  goal         Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}
