// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goals     Goal[]
}

model Goal {
  id          String     @id @default(uuid())
  title       String
  description String?
  owner       String
  categories  Category[]
  progress    Int        @default(0)
  size        String     @default("medium")
  startDate   String?
  dueDate     String?
  statusNote  String?
  order       Int        @default(0)
  completed   Boolean    @default(false)
  version     Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subGoals    SubGoal[]
  notes       Note[]

  @@index([owner])
}

model SubGoal {
  id          String   @id @default(uuid())
  title       String
  description String?
  owner       String
  progress    Int      @default(0)
  startDate   String?
  dueDate     String?
  statusNote  String?
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([goalId])
}

model Note {
  id        String   @id @default(uuid())
  content   String
  isPinned  Boolean  @default(false)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
}

model User {
  id        String     @id @default(uuid())
  googleId  String     @unique
  email     String     @unique
  name      String
  picture   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]

  @@index([email])
  @@index([googleId])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE, UPDATE, DELETE, REORDER
  entityType  String   // Goal, SubGoal, Note, Category
  entityId    String   // ID of the changed entity
  entityTitle String?  // Title/name of the entity (for reference)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes     String?  // JSON string with change details
  createdAt   DateTime @default(now())

  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}
